PROCUREX_ENVIRONMENT=local
PROCUREX_DEBUG=true
PROCUREX_ALLOWED_HOSTS=["localhost","127.0.0.1"]
PROCUREX_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
PROCUREX_DATABASE_URL=postgresql+asyncpg://procurex:procurex@localhost:5432/procurex
PROCUREX_DATABASE_ECHO=false
PROCUREX_DATABASE_POOL_SIZE=10
PROCUREX_DATABASE_MAX_OVERFLOW=20
PROCUREX_READINESS_TIMEOUT_SECONDS=3

PROCUREX_AUTH_MODE=dev_headers
PROCUREX_DEV_BOOTSTRAP_KEY=local-development-only
PROCUREX_OIDC_ISSUER=
PROCUREX_OIDC_AUDIENCE=

PROCUREX_CLOUDINARY_CLOUD_NAME=
PROCUREX_CLOUDINARY_API_KEY=
PROCUREX_CLOUDINARY_API_SECRET=
PROCUREX_CLOUDINARY_FOLDER_PREFIX=procurex/local
PROCUREX_DOCUMENT_MAX_UPLOAD_BYTES=26214400
PROCUREX_DOCUMENT_UPLOAD_INTENT_TTL_SECONDS=600

PROCUREX_RABBITMQ_URL=amqp://procurex:procurex@localhost:5672//
PROCUREX_REDIS_URL=redis://localhost:6379/0

PROCUREX_LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://procurex:procurex@localhost:5432/procurex
PROCUREX_LLM_PROVIDER=gemini
PROCUREX_LLM_MODEL=gemini-3.1-pro-preview
PROCUREX_GEMINI_API_KEY=
PROCUREX_LLM_TIMEOUT_SECONDS=90
PROCUREX_LLM_MAX_RETRIES=2
PROCUREX_EVALUATION_EVIDENCE_LIMIT=120
PROCUREX_EVALUATION_EVIDENCE_MAX_CHARS=60000
